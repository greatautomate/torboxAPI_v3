# ---- required ----
MONGODB_URI=mongodb://127.0.0.1:27017            # MongoDB Atlas SRV URI in production
MONGODB_DB_NAME=torbox_gateway
MASTER_ENCRYPTION_KEY=                            # 32 random bytes, base64 (openssl rand -base64 32)
SESSION_SECRET=                                   # random string
PERMALINK_SIGNING_SECRET=                         # random string
WEBHOOK_INBOUND_SECRET=                           # random string
# ---- bootstrap (first boot only) ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
TORBOX_API_KEY=                                   # optional: seeds the first upstream account, encrypted in Mongo
# ---- optional ----
PORT=10000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:10000
TORBOX_API_BASE=https://api.torbox.app            # point to http://localhost:10100 to use the bundled mock server
NODE_ENV=development
LOG_LEVEL=info
UPSTREAM_GLOBAL_PER_MINUTE=280
UPSTREAM_GLOBAL_CREATE_UNCACHED_PER_HOUR=55
UPSTREAM_GLOBAL_CREATE_USENET_PER_HOUR=55
UPSTREAM_GLOBAL_CREATE_WEBDL_PER_HOUR=55
LOG_RETENTION_DAYS=30
MAX_UPLOAD_MB=100
TRUST_PROXY=true
RUN_JOBS_IN_PROCESS=true                          # web service also runs the scheduler (lease-locked); cron service can run it too
